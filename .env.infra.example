# Names only. Copy to ~/math/.env.infra on the server and fill in the values there; the real file is never committed.

# The platform's domain (the same value as in the infrastructure repo's .env).
DOMAIN=

# Printed once by `scripts/new-app.sh math` in the infrastructure repo:
# postgresql+psycopg://<role>:<password>@<postgres host>:5432/math
MATH_DATABASE_URL=

# Optional.
# MATH_ALLOWED_ORIGINS=      # default https://math.<DOMAIN>
# SSO_JWKS_URL=              # only where the login service is not reachable at https://auth.<DOMAIN>
