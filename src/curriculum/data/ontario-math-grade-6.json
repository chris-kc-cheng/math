    [
      "Number foundations",
      "Build place value, representation, and operation reasoning."
    ],
    [
      "Patterns and relationships",
      "Connect number work to patterns, expressions, and equations."
    ],
    [
      "Measurement and spatial reasoning",
      "Apply number skills to units, shapes, and transformations."
    ],
    [
      "Data and probability",
      "Collect, represent, interpret, and question evidence."
    ],
    [
      "Financial applications",
      "Use number and data skills in stated classroom financial scenarios."
    ],
    [
      "Across all strands",
      "Revisit coding, modelling, communication, and reflection throughout."
    ]
  ],
